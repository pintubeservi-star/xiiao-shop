{
  "expo": {
    "name": "Cotuí Go",
    "slug": "cotui-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "cotuigo",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cotuigo.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Cotuí Go usa tu ubicación para mostrar recogidas y entregas cercanas."
      }
    },
    "android": {
      "package": "com.cotuigo.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F4F7F5"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite a Cotuí Go usar tu ubicación para solicitar y seguir servicios.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Permite a Cotuí Go compartir la ubicación del repartidor mientras esté disponible para entregas."
        }
      ],
      "expo-notifications",
      "@maplibre/maplibre-react-native",
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ]
    ],
    "newArchEnabled": true
  }
}
